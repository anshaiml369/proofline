# Nothing here is required. Voice input is Wispr Flow (OS-level dictation), and the agent
# speaks with the browser's own voice. The app runs fully with no .env.

# Optional: Sarvam Bulbul voice, used only when the browser has no Hindi voice
SARVAM_API_KEY=
# Optional: an LLM reads answers instead of the built-in rules (it never does arithmetic)
OPENROUTER_API_KEY=
