# Nothing here is required. Voice input is Wispr Flow (OS-level dictation), and the app runs
# fully with no .env, using built-in rules and a recorded voice.

# Optional: an LLM understands each message and replies to what the worker said.
# It never does arithmetic. OpenAI is tried first, then OpenRouter.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional: Sarvam Bulbul, the agent's natural Hindi voice
SARVAM_API_KEY=
